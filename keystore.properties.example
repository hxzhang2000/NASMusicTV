# keystore.properties 示例模板（实际文件 gitignored，请勿提交真实值）
# 复制为 keystore.properties 后填入真实值

# ---- 发布签名 ----
storeFile=
storePassword=
keyAlias=
keyPassword=

# ---- 百度网盘开放平台凭据（设备码模式需要）----
# 在 https://pan.baidu.com/union/ 注册应用后获取；个人认证免费额度足够个人使用
# 留空时 BaiduOAuthClient 会回退，但百度源将无法鉴权
baiduAppId=
baiduAppSecret=
